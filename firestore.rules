rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function validRouletteUpdate() {
      let before = resource.data.get('ruleta', {});
      let after = request.resource.data.get('ruleta', {});
      return after.keys().hasOnly(['all', 'marvel', 'anime', 'disney'])
        && after.diff(before).affectedKeys().size() == 1
        && (!before.keys().hasAny(['all']) || after.all == before.all)
        && (!before.keys().hasAny(['marvel']) || after.marvel == before.marvel)
        && (!before.keys().hasAny(['anime']) || after.anime == before.anime)
        && (!before.keys().hasAny(['disney']) || after.disney == before.disney)
        && (!after.keys().hasAny(['all']) || after.all.precio == 80)
        && (!after.keys().hasAny(['marvel']) || after.marvel.precio == 100)
        && (!after.keys().hasAny(['anime']) || after.anime.precio == 100)
        && (!after.keys().hasAny(['disney']) || after.disney.precio == 100);
    }

    match /usuarios/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.rol == 'cliente'
        && request.resource.data.jimmyCoins == 0;

      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // El cliente solo puede guardar su propio resultado de la ruleta.
      // Coins, precios, reservas y permisos quedan en manos de administradores.
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ruleta'])
        && validRouletteUpdate()
      );

      allow delete: if isAdmin();
    }

    match /inventario/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
