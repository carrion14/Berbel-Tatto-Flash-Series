rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function validRouletteUpdate() {
      let before = resource.data.get('ruleta', {});
      let after = request.resource.data.get('ruleta', {});
      return after.diff(before).affectedKeys().size() == 1
        && after.keys().hasAll(before.keys())
        && after.keys().size() == before.keys().size() + 1;
    }

    function validPaidReroll() {
      let before = resource.data.get('ruleta', {});
      let after = request.resource.data.get('ruleta', {});
      return resource.data.get('jimmyCoins', 0) >= 20
        && request.resource.data.jimmyCoins == resource.data.jimmyCoins - 20
        && request.resource.data.jimmyCoins >= 0
        && after.diff(before).affectedKeys().size() == 1
        && after.keys().hasAll(before.keys())
        && before.keys().hasAll(after.keys());
    }

    match /usuarios/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.rol == 'cliente'
        && request.resource.data.jimmyCoins == 0;

      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // El cliente puede guardar su primer premio o pagar exactamente 20 JC
      // para sustituir un único resultado ya existente.
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ruleta']) && validRouletteUpdate())
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ruleta', 'jimmyCoins']) && validPaidReroll())
        )
      );

      allow delete: if isAdmin();
    }

    match /inventario/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /disenos/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /configuracion/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
